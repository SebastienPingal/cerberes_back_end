NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5436/cerberes
# Required. Generate one with: openssl rand -base64 48
JWT_SECRET=
PORT=3000
# Comma separated list of front-end origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3333
# Optional, e.g. .yourdomain.com to share the auth cookie across subdomains
COOKIE_DOMAIN=
